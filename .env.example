# =============================================
# DATABASE
# =============================================
DB_HOST=127.0.0.1
DB_NAME=your_database_name
DB_USERNAME=root
DB_PASSWORD=

# =============================================
# APP
# =============================================
APP_URL=http://localhost/avalon-roditelj/
APP_PATH=/avalon-roditelj/
APP_TIMEZONE=Europe/Belgrade

# Link ka admin aplikaciji.
ADMIN_APP_URL=http://localhost/avalon/

# Fotografije polaznika — deljeni folder sa avalon-student aplikacijom
STUDENT_PHOTOS_PATH=/home/goran/avalon-student/assets/uploads/djaci/
STUDENT_PHOTOS_URL=https://student.example.com/assets/uploads/djaci/

# =============================================
# MAIL
# =============================================
MAIL_HOST=mail.example.com
MAIL_USERNAME=your@email.com
MAIL_PASSWORD=your_mail_password
MAIL_PORT=465
MAIL_ENCRYPTION=ssl
MAIL_FROM_EMAIL=your@email.com

# Posiljalac i potpis (vazi za SVE mejlove iz aplikacije)
MAIL_POSILJALAC="School Management System"
MAIL_POTPISNIK="Vaš School Management System"
# Opciono — ako je prazno, ne pojavljuje se u potpisu
MAIL_POTPIS_TELEFON=
MAIL_POTPIS_SAJT=https://sms.co.rs

# =============================================
# SECURITY
# =============================================
MASTER_PASSWORD_HASH=generate_with_password_hash()
